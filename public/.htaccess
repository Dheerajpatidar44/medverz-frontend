# ----------------------------------------------------------------------
# Next.js Static Export .htaccess for Hostinger
# Handles clean URLs, redirects, and prevents 404/blank pages
# ----------------------------------------------------------------------

Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Force HTTPS (Auto-redirect to secure HTTPS connection)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

# 3. Serve Clean URLs (e.g. resolve /about to /about.html internally)
# Works even if a physical directory with the same name exists (Next.js static export style)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# 4. Prevent 404/Blank page on Page Refresh (Fallback to index.html for SPA/dynamic routes)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# 5. Enable Gzip Compression (Optimizes loading speed on Hostinger)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 6. Leverage Browser Caching for static assets (Increases load speeds on repeat visits)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
